# ShopPulse Firebase Configuration Template
# Copy this file to .env and fill in your Firebase Console credentials

VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=shoppulse-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shoppulse-app
VITE_FIREBASE_STORAGE_BUCKET=shoppulse-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Frontend variables prefixed with VITE_ are compiled into the public JavaScript bundle.
# Never put API secrets here. The optional Gemini key for the in-browser fallback scanner
# is entered by each user under Invoice Scanner > Engine Settings and stays in that browser.
# MRP provider credentials belong in backend/.env (see backend/.env.example).

