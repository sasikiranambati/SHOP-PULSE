# API Settings
PROJECT_NAME="ShopPulse API"
API_V1_STR="/api/v1"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="shoppulse"

# JWT Settings
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Voice-to-Bill Settings
# Options: "mock" (default, zero-API key local development) or "sarvam" (multilingual STT)
VOICE_MODE=mock
# SARVAM_API_KEY="your-sarvam-ai-subscription-key-here"

# ---------------------------------------------------------------------------
# MRP (Maximum Retail Price) lookup for the invoice scanner — backend only.
# Keys set here are never sent to the browser. Do not commit a filled-in .env.
# ---------------------------------------------------------------------------
# MRP_PROVIDER: openmrp (default) | custom_http | none
#   openmrp     OpenMRP is a manufacturing / Material Requirements Planning platform.
#               It publishes no Maximum Retail Price, so lookups report MRP_UNAVAILABLE
#               (or API_CONFIGURATION_ERROR when OPENMRP_API_KEY is empty).
#   custom_http Any JSON product API with a documented MRP field (configure below).
#   none        Disable external lookups; MRP comes from the invoice or manual entry.
MRP_PROVIDER=openmrp
MRP_LOOKUP_ENABLED=true
MRP_LOOKUP_TIME_BUDGET_SECONDS=12

# OpenMRP (https://api.openmrp.ai) — catalog identity only, no MRP data
OPENMRP_API_KEY=
OPENMRP_ACCOUNT_ID=
OPENMRP_API_VERSION=1.0.forge-preview.3

# custom_http provider (fill in from the provider's API documentation)
# MRP_API_BASE_URL=https://api.example-provider.com/v1
# MRP_API_KEY=your-provider-api-key
# MRP_API_AUTH_HEADER=Authorization
# MRP_API_AUTH_SCHEME=Bearer
# MRP_API_BARCODE_PATH=/products/{barcode}
# MRP_API_SEARCH_PATH=/products/search
# MRP_API_SEARCH_PARAM=q
# MRP_API_RESULTS_FIELD=products
# MRP_API_MRP_FIELD=mrp            # REQUIRED: the provider's documented MRP field (dotted path allowed)
# MRP_API_NAME_FIELD=name
# MRP_API_BRAND_FIELD=brand
# MRP_API_BARCODE_FIELD=barcode
# MRP_API_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Backend OCR (tesseract.js via Node). Language data ships with `npm install`
# (@tesseract.js-data/eng). Override for offline/air-gapped servers if needed.
# ---------------------------------------------------------------------------
# OCR_LANG_PATH=/opt/tessdata        # directory containing eng.traineddata(.gz)
# OCR_CACHE_DIR=/var/cache/shoppulse-ocr
