rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    
    // Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Strictly check if authenticated user matches document owner/UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate positive numeric amounts
    function isPositiveNumber(num) {
      return num is number && num >= 0;
    }

    // Validate non-empty string
    function isNonEmptyString(str) {
      return str is string && str.size() > 0 && str.size() <= 200;
    }

    // -------------------------------------------------------------------------
    // User-Isolated Structure: users/{userId}/...
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // User root document
      allow read, write: if isOwner(userId);

      // User profile subcollection
      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      // User isolated inventory subcollection
      match /inventory/{productId} {
        allow read, write: if isOwner(userId);
      }

      // User isolated sales transactions subcollection
      match /sales/{saleId} {
        allow read, write: if isOwner(userId);
      }

      // User isolated smart alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }

      // User isolated analytics cache and snapshots
      match /analytics/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Legacy Global Collections: Block Direct Access
    // Protect historical collections from unisolated reads/writes
    // -------------------------------------------------------------------------
    match /products/{document=**} {
      allow read, write: if false;
    }

    match /sales/{document=**} {
      allow read, write: if false;
    }

    match /alerts/{document=**} {
      allow read, write: if false;
    }

    match /inventory_alerts/{document=**} {
      allow read, write: if false;
    }

    match /daily_analytics/{document=**} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
